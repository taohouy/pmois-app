# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pmois
# DB_USERNAME=pmois_app
# DB_PASSWORD=change-me

# === Security (MANDATORY in production) ===
APP_SECRET=change-me-random-32-chars-minimum
APP_DEBUG=false

# === OAuth Cookie Domain (REQUIRED for production cross-domain LINE round-trip) ===
# Set to the production domain so the pmois_oauth_fp cookie survives the redirect
# from PMOIS -> access.line.me -> PMOIS callback.
# Example: OAUTH_COOKIE_DOMAIN=pmo.jaideedigital.com
# If empty, no Domain attribute is set (cookie uses the current host only —
# fine for dev/localhost, but in production the cookie MUST have the domain set
# or the callback will see an empty fingerprint cookie and reject with STATE_MISMATCH).
OAUTH_COOKIE_DOMAIN=pmo.jaideedigital.com

# === LINE Login (only IdP per CTO Constraint) ===
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=https://pmo.jaideedigital.com/auth/line/callback

# === Telegram (only notification provider per CTO Constraint) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === GitLab (only source control per CTO Constraint) ===
# base_url จัดการในระบบผ่าน git_providers registry (seed: https://gitlab.com)

# === Rate limiting ===
RATE_LIMIT_PER_MINUTE=120

# === Storage ===
STORAGE_BASE_PATH=/var/www/pmois/storage/uploads
